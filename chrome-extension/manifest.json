{
  "manifest_version": 3,
  "name": "XPU成绩助手--Ryan_cy",
  "version": "2.0.8",
  "description": "在教务系统成绩页面直接查看和筛选各学期成绩。",
  "permissions": ["storage"],
  "host_permissions": ["https://jwglxt.xpu.edu.cn/*"],
  "content_scripts": [
    {
      "matches": ["https://jwglxt.xpu.edu.cn/student/for-std/grade/sheet/semester-index/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/reward.jpg"],
      "matches": ["https://jwglxt.xpu.edu.cn/*"]
    }
  ],
  "action": {
    "default_title": "XPU成绩助手--Ryan_cy",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
